{
  "about": "S-132 natural-language search eval: typed text → GET /api/v1/search filters (SearchFiltersEval). `expect` lists the filters that must come out exactly (kind, dietary, allergenFree, tier compared as sets; maxPrice/minPrice in cents; q must contain `qHas`); `absent` lists filters that must NOT be set (nothing invented). hasLocation says whether the person shared a location. `input` is the text; mock.json is the simulated model's reply.",
  "cases": [
    {"id": "halal-pho", "input": "cheap halal pho open now", "hasLocation": true, "qHas": "pho",
     "expect": {"kind": ["food"], "dietary": ["halal"], "openNow": true, "sort": "price_asc"}, "absent": ["minRating", "radiusKm", "maxPrice"],
     "mock": {"json": {"q": "pho", "kinds": ["food"], "dietary": ["halal"], "openNow": true, "sort": "price_asc", "explanation": "Halal pho open now, cheapest first."}}},
    {"id": "brakes-under-150", "input": "brake repair under $150 with good reviews", "hasLocation": false, "qHas": "brake",
     "expect": {"kind": ["service"], "maxPrice": 15000, "minRating": 4.5}, "absent": ["sort", "radiusKm"],
     "mock": {"json": {"q": "brake repair", "kinds": ["service"], "maxPriceDollars": 150, "minRating": 4.5, "explanation": "Brake repair under $150, rated 4.5+."}}},
    {"id": "wipers-tonight", "input": "wiper blades delivered tonight", "hasLocation": true, "qHas": "wiper",
     "expect": {"kind": ["product"], "delivery": "tonight"}, "absent": ["maxPrice", "minRating"],
     "mock": {"json": {"q": "wiper blades", "kinds": ["product"], "deliveryTonight": true, "explanation": "Wiper blades on tonight's run."}}},
    {"id": "nut-free", "input": "nut-free vegan dinner", "hasLocation": false, "qHas": "dinner",
     "expect": {"kind": ["food"], "dietary": ["vegan"], "allergenFree": ["peanuts", "tree_nuts"]}, "absent": ["sort", "radiusKm"],
     "mock": {"json": {"q": "dinner", "kinds": ["food"], "dietary": ["vegan"], "allergenFree": ["peanuts", "tree_nuts"], "explanation": "Vegan dinner without nuts."}}},
    {"id": "closest-no-location", "input": "closest plumber", "hasLocation": false, "qHas": "plumber",
     "expect": {"kind": ["service"]}, "absent": ["sort", "radiusKm"],
     "mock": {"json": {"q": "plumber", "kinds": ["service"], "sort": "distance", "radiusKm": 5, "explanation": "Plumbers."}}},
    {"id": "closest-with-location", "input": "plumber within 5 km", "hasLocation": true, "qHas": "plumber",
     "expect": {"kind": ["service"], "radiusKm": 5.0}, "absent": ["maxPrice"],
     "mock": {"json": {"q": "plumber", "kinds": ["service"], "radiusKm": 5, "explanation": "Plumbers within 5 km."}}},
    {"id": "best-mechanic", "input": "the best mechanic I can book right away", "hasLocation": false, "qHas": "mechanic",
     "expect": {"kind": ["service"], "tier": ["master"], "instantBook": true}, "absent": ["maxPrice"],
     "mock": {"json": {"q": "mechanic", "kinds": ["service"], "tiers": ["master"], "instantBook": true, "explanation": "Master-tier mechanics you can book now."}}},
    {"id": "fr", "input": "poutine pas chère ouverte maintenant", "lang": "fr", "hasLocation": true, "qHas": "poutine",
     "expect": {"kind": ["food"], "openNow": true, "sort": "price_asc"}, "absent": ["minRating"],
     "mock": {"json": {"q": "poutine", "kinds": ["food"], "openNow": true, "sort": "price_asc", "explanation": "Poutine ouverte maintenant, la moins chère d'abord."}}},
    {"id": "plain", "input": "oil change", "hasLocation": false, "qHas": "oil",
     "expect": {}, "absent": ["maxPrice", "minPrice", "minRating", "openNow", "sort", "dietary", "tier"],
     "mock": {"json": {"q": "oil change", "kinds": ["service"], "explanation": "Oil changes."}}},
    {"id": "invented-values", "input": "sushi platter", "hasLocation": false, "qHas": "sushi",
     "expect": {"kind": ["food"]}, "absent": ["dietary", "tier"],
     "mock": {"json": {"q": "sushi platter", "kinds": ["food", "spaceship"], "dietary": ["keto"], "tiers": ["platinum"], "explanation": "Sushi platters."}}}
  ]
}
