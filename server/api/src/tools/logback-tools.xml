<configuration>
  <appender name="OUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <logger name="org.flywaydb.core.FlywayExecutor" level="WARN"/>
  <root level="INFO"><appender-ref ref="OUT"/></root>
</configuration>
