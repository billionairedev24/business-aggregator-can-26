{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:payments.refund_issued:1",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "escrowId",
    "amountCents",
    "chargedTo"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "payments.refunds.id"
    },
    "merchantId": {
      "type": "string"
    },
    "caseNumber": {
      "type": "string",
      "description": "RF-… case number (added by S-13; optional for older events)"
    },
    "escrowId": {
      "type": [
        "string",
        "null"
      ]
    },
    "amountCents": {
      "type": "integer",
      "minimum": 1
    },
    "chargedTo": {
      "enum": [
        "merchant",
        "platform"
      ]
    }
  }
}
