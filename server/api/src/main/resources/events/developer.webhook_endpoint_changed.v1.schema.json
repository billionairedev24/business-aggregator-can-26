{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:developer.webhook_endpoint_changed:1",
  "description": "A webhook endpoint was created, re-keyed, turned back on (S-33) or deleted; the webhook worker reads endpoints at delivery time. Topic developer.webhook_endpoint, key = endpoint id.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "actorId",
    "merchantId",
    "change"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "developer.webhook_endpoints.id"
    },
    "actorId": {
      "type": "string"
    },
    "merchantId": {
      "type": "string"
    },
    "change": {
      "type": "string",
      "enum": [
        "created",
        "secret_rotated",
        "enabled",
        "deleted"
      ]
    }
  }
}
