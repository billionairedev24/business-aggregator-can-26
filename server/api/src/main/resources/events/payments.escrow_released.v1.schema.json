{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:payments.escrow_released:1",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "refType",
    "refId",
    "grossCents",
    "feeCents",
    "netCents"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "payments.escrows.id"
    },
    "merchantId": {
      "type": "string"
    },
    "refType": {
      "enum": [
        "booking",
        "order_line"
      ]
    },
    "refId": {
      "type": "string"
    },
    "grossCents": {
      "type": "integer",
      "minimum": 0
    },
    "feeCents": {
      "type": "integer",
      "minimum": 0
    },
    "netCents": {
      "type": "integer",
      "minimum": 0
    }
  }
}
