{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:fulfilment.run_changed:1",
  "description": "run.changed — topic fulfilment.run, key = run id. A courier's run changed after it was given to them (unassigned: dispatch gave it to another courier).",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "courierId",
    "change"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "fulfilment.runs.id"
    },
    "courierId": {
      "type": "string",
      "description": "fulfilment.couriers.id of the courier the change is for"
    },
    "change": {
      "enum": [
        "unassigned"
      ]
    }
  }
}
