{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:payments.payout_sent:1",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "kind",
    "amountCents",
    "feeCents",
    "arrivesAt"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "payments.payouts.id"
    },
    "merchantId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "scheduled",
        "instant"
      ]
    },
    "amountCents": {
      "type": "integer",
      "minimum": 1
    },
    "feeCents": {
      "type": "integer",
      "minimum": 0
    },
    "arrivesAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
