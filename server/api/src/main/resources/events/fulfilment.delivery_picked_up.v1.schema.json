{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:fulfilment.delivery_picked_up:1",
  "description": "delivery.picked_up — topic fulfilment.delivery, key = order id. The courier collected the order from every shop on it.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "runId",
    "courierId"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "orders.orders.id"
    },
    "runId": {
      "type": "string",
      "description": "fulfilment.runs.id"
    },
    "courierId": {
      "type": "string",
      "description": "fulfilment.couriers.id"
    }
  }
}
