{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:catalogue.instant_book_changed:1",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "effective"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "merchants.merchants.id (the business whose services' instant booking changed)"
    },
    "merchantId": {
      "type": "string",
      "description": "merchants.merchants.id"
    },
    "effective": {
      "type": "boolean",
      "description": "whether customers can book the business's instant-book services instantly now"
    }
  }
}
