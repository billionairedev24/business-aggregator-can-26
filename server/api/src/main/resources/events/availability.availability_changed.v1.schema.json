{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:availability.availability_changed:1",
  "description": "availability.changed — topic availability.availability, key = merchant id.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "actorId",
    "what"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "merchants.merchants.id"
    },
    "actorId": {
      "type": "string",
      "description": "identity.users.id of the team member"
    },
    "what": {
      "enum": [
        "hours",
        "rules",
        "time_off",
        "holidays",
        "team"
      ]
    }
  }
}
