{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:fulfilment.delivery_assigned:1",
  "description": "delivery.assigned \u2014 topic fulfilment.run, key = run id. A courier on shift was given the run.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "courierId",
    "orderIds",
    "merchantIds",
    "orderType"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "fulfilment.runs.id"
    },
    "courierId": {
      "type": "string",
      "description": "fulfilment.couriers.id"
    },
    "orderIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "merchantIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "merchants.merchants.id of each pickup"
    },
    "orderType": {
      "enum": [
        "goods",
        "food"
      ]
    }
  }
}
