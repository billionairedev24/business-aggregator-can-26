{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:orders.order_delivered:1",
  "description": "order.delivered \u2014 topic orders.order, key = order id. Goods: starts the 7-day escrow window.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "orderType",
    "proof"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "orders.orders.id"
    },
    "orderType": {
      "enum": [
        "goods",
        "food"
      ]
    },
    "proof": {
      "enum": [
        "photo",
        "signature",
        "pin"
      ]
    }
  }
}
