{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:payments.payout_failed:1",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "outcome",
    "amountCents"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "payments.payouts.id"
    },
    "merchantId": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "failed",
        "canceled"
      ]
    },
    "amountCents": {
      "type": "integer",
      "minimum": 1
    },
    "failureCode": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
