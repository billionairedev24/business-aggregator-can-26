{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:catalogue.listing_hidden:1",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "kind"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "catalogue.offers.id or catalogue.services.id"
    },
    "merchantId": {
      "type": "string",
      "description": "merchants.merchants.id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "service",
        "product"
      ]
    }
  }
}
