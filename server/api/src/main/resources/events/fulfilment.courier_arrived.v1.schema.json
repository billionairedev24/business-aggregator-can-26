{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:fulfilment.courier_arrived:1",
  "description": "delivery.courier_arrived \u2014 topic fulfilment.delivery, key = order id. The courier is at the shop or kitchen.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "orderType",
    "runId"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "orders.orders.id"
    },
    "merchantId": {
      "type": "string",
      "description": "merchants.merchants.id"
    },
    "orderType": {
      "enum": [
        "goods",
        "food"
      ]
    },
    "runId": {
      "type": "string",
      "description": "fulfilment.runs.id"
    }
  }
}
