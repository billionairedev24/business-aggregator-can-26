{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:food.kitchen_auto_resumed:1",
  "description": "kitchen.auto_resumed — S-67: the kitchen caught up after an auto-pause; customers can order again. Topic food.kitchen, key = merchant id.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "merchants.merchants.id"
    }
  }
}
