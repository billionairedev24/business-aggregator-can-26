{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:fulfilment.delivery_failed:1",
  "description": "delivery.failed (S-151) — topic fulfilment.delivery, key = order id. The courier couldn't hand the order over (photo at the door); the goods go back to the shops and the customer chooses re-delivery or a refund. Codes only: never the courier's note.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "reason",
    "attempt"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "orders.orders.id"
    },
    "runId": {
      "type": ["string", "null"],
      "description": "fulfilment.runs.id"
    },
    "stopId": {
      "type": ["string", "null"],
      "description": "fulfilment.stops.id (the drop-off)"
    },
    "courierId": {
      "type": ["string", "null"],
      "description": "fulfilment.couriers.id"
    },
    "reason": {
      "enum": [
        "absent",
        "unsafe",
        "refused",
        "access",
        "other"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "1 for the first delivery, 2 for the first re-delivery, …"
    }
  }
}
