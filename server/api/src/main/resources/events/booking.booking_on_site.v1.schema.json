{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:booking.booking_on_site:1",
  "description": "booking.on_site — geofenced check-in. Topic booking.booking, key = booking id.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "actorId"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "booking.bookings.id"
    },
    "merchantId": {
      "type": "string",
      "description": "merchants.merchants.id"
    },
    "actorId": {
      "type": "string",
      "description": "identity.users.id of the team member"
    }
  }
}
