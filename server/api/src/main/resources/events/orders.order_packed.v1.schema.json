{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:orders.order_packed:1",
  "description": "order.packed — topic orders.order, key = order id.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "actorId",
    "linesPacked",
    "orderState"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "orders.orders.id"
    },
    "merchantId": {
      "type": "string",
      "description": "merchants.merchants.id"
    },
    "actorId": {
      "type": "string",
      "description": "identity.users.id of the team member"
    },
    "linesPacked": {
      "type": "integer",
      "minimum": 1
    },
    "orderState": {
      "enum": [
        "packing",
        "ready"
      ]
    }
  }
}
