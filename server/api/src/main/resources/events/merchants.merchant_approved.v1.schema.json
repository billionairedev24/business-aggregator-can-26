{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:merchants.merchant_approved:1",
  "type": "object",
  "required": ["eventId", "occurredAt", "aggregateId", "actorId", "merchantType", "tier"],
  "additionalProperties": true,
  "properties": {
    "eventId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "string", "description": "merchants.merchants.id" },
    "actorId": { "type": "string", "description": "identity.users.id of the approver" },
    "merchantType": { "enum": ["provider", "seller", "kitchen", "both"] },
    "tier": { "enum": ["registered", "trusted", "master"] }
  }
}
