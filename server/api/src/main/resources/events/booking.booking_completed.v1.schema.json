{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:booking.booking_completed:1",
  "description": "booking.completed — escrow releases on sign-off or 48 h later (photoCount 0 delays release). Topic booking.booking.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "merchantId",
    "actorId",
    "photoCount"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "description": "booking.bookings.id"
    },
    "merchantId": {
      "type": "string",
      "description": "merchants.merchants.id"
    },
    "actorId": {
      "type": "string",
      "description": "identity.users.id of the team member"
    },
    "photoCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
