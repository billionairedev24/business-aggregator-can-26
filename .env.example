# .env.example — settings for `docker compose` (local stand-ins). `cp .env.example .env` and edit; .env is git-ignored.
# The app settings live in server/.env (server/.env.example) and web/apps/studio/.env (web/apps/studio/.env.example).
# Keep the ports here and the URLs in server/.env in step if you change them.

# Which stand-ins `docker compose up -d` starts (comma-separated). Leave out what you run yourself — e.g. with your
# own Postgres + PostGIS and Valkey: COMPOSE_PROFILES=mail,storage
#   db       Postgres 17 + PostGIS            :5432
#   cache    Valkey 8                         :6379
#   events   Kafka 4 (KRaft) + topic creation :9092
#   search   Elasticsearch 9                  :9200
#   mail     Mailpit (SMTP / web UI)          :1025 / :8025
#   storage  S3-compatible storage + bucket   :9100 / console :9101
#   payments stripe-mock                      :12111
#   all      all of the above
#   tools    Kafka UI :8190, Kibana :5601 (add to the others)
# The `local` Spring profile needs only `db`.
COMPOSE_PROFILES=db

# Postgres (profile db) — must match DB_URL / DB_USER / DB_PASSWORD in server/.env.
PG_PORT=5432
PG_DATABASE=northline
PG_USER=northline
PG_PASSWORD=northline

# Valkey (profile cache) — REDIS_PORT in server/.env.
VALKEY_PORT=6379

# Kafka (profile events) — KAFKA_BOOTSTRAP=localhost:<port> in server/.env.
KAFKA_PORT=9092

# Elasticsearch (profile search) — ES_URIS in server/.env. Heap for the container.
ES_PORT=9200
ES_HEAP=1g

# Mailpit (profile mail) — the api's local email goes here (S-13; SMTP_PORT in server/.env); inbox http://localhost:8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Object storage (profile storage, RustFS) — the api uses it with STORAGE_PROVIDER=s3 and the same STORAGE_* values in
# server/.env (docs/runbooks/object-storage.md). Change STORAGE_PORT and STORAGE_ENDPOINT together.
STORAGE_PORT=9100
STORAGE_CONSOLE_PORT=9101
STORAGE_ACCESS_KEY=northline
STORAGE_SECRET_KEY=northline-dev-secret
STORAGE_BUCKET=northline-local
STORAGE_REGION=ca-central-1

# stripe-mock (profile payments) — STRIPE_API_BASE=http://localhost:<port> in server/.env.
STRIPE_MOCK_PORT=12111

# UIs (profile tools).
KAFKA_UI_PORT=8190
KIBANA_PORT=5601
