{
  "name": "@northline/consumer-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:fixtures": "EXPO_PUBLIC_FIXTURES=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
