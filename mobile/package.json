{
  "name": "northline-mobile",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings=0 && node packages/release/src/cli.mjs check",
    "release:check": "node packages/release/src/cli.mjs check",
    "courier": "pnpm --filter @northline/courier start",
    "consumer": "pnpm --filter @northline/consumer-app start"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
