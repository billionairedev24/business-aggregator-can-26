{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:webhook.refund.issued:1",
  "title": "Northline webhook refund.issued v1",
  "description": "A refund was paid back to the customer's original payment method.",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "createdAt",
    "merchantId",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Event id (ULID). The same event keeps its id on every retry and resend: deduplicate on it."
    },
    "type": {
      "type": "string",
      "enum": [
        "refund.issued"
      ]
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Payload version; a breaking change ships as a new version."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened (UTC)."
    },
    "merchantId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Your business (Studio URL /b/<merchantId>)."
    },
    "data": {
      "type": "object",
      "required": [
        "refundId",
        "caseNumber",
        "escrowId",
        "amountCents",
        "currency",
        "chargedTo"
      ],
      "additionalProperties": false,
      "properties": {
        "refundId": {
          "type": "string"
        },
        "caseNumber": {
          "type": [
            "string",
            "null"
          ],
          "description": "RF-… as shown in Refunds & disputes."
        },
        "escrowId": {
          "type": [
            "string",
            "null"
          ]
        },
        "amountCents": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "enum": [
            "CAD"
          ]
        },
        "chargedTo": {
          "type": "string",
          "enum": [
            "merchant",
            "platform"
          ],
          "description": "Who bears the refund."
        }
      }
    }
  }
}
