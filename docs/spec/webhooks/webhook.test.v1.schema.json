{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:webhook.webhook.test:1",
  "title": "Northline webhook webhook.test v1",
  "description": "Sent from Studio › Settings › API & integrations (Send test event). Not a business event: acknowledge it with 2xx.",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "createdAt",
    "merchantId",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Event id (ULID). The same event keeps its id on every retry and resend: deduplicate on it."
    },
    "type": {
      "type": "string",
      "enum": [
        "webhook.test"
      ]
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Payload version; a breaking change ships as a new version."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened (UTC)."
    },
    "merchantId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Your business (Studio URL /b/<merchantId>)."
    },
    "data": {
      "type": "object",
      "required": [
        "endpointId"
      ],
      "additionalProperties": false,
      "properties": {
        "endpointId": {
          "type": "string",
          "description": "The endpoint the test was sent to."
        }
      }
    }
  }
}
