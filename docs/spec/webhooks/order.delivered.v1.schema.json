{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northline:webhook.order.delivered:1",
  "title": "Northline webhook order.delivered v1",
  "description": "An order with lines from your business reached the customer (the courier's drop-off with proof). Goods: your lines' payment releases 7 days later unless the customer confirms sooner or reports a problem. No customer details.",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "createdAt",
    "merchantId",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Event id (ULID). The same event keeps its id on every retry and resend: deduplicate on it."
    },
    "type": {
      "type": "string",
      "enum": [
        "order.delivered"
      ]
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Payload version; a breaking change ships as a new version."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened (UTC)."
    },
    "merchantId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Your business (Studio URL /b/<merchantId>)."
    },
    "data": {
      "type": "object",
      "required": [
        "orderId",
        "orderType",
        "proof"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string",
          "description": "The order of your order.placed event."
        },
        "orderType": {
          "type": "string",
          "enum": [
            "goods",
            "food"
          ]
        },
        "proof": {
          "type": "string",
          "enum": [
            "photo",
            "signature",
            "pin"
          ],
          "description": "How the courier proved the drop-off."
        }
      }
    }
  }
}
