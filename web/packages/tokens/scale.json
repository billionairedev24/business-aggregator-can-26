{
  "$comment": "The fixed rhythm of the AfroTransact layout language (docs/design/redesign-spec.md § 1.2): spacing, type scale, control sizes, shadows, z-index, motion and the page grid. Not part of the brand: a rebrand cannot change it.",
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "text": { "2xs": 11, "xs": 12, "sm": 13, "md": 14, "base": 15, "lg": 17, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 38, "5xl": 52 },
  "fluid": {
    "2xl": "clamp(21px, 19px + 0.5vw, 24px)",
    "3xl": "clamp(24px, 20px + 1vw, 30px)",
    "4xl": "clamp(28px, 22px + 1.6vw, 38px)",
    "5xl": "clamp(34px, 22px + 3.2vw, 52px)"
  },
  "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 800 },
  "leading": { "tight": 1.2, "normal": 1.45, "relaxed": 1.6 },
  "tracking": { "tight": "-0.015em", "caps": "0.06em" },
  "size": { "control-sm": 32, "control": 40, "control-lg": 48, "touch": 44, "header-mark": 32, "sidebar": 264, "rail": 72, "sheet": 680 },
  "page": { "max": 1500, "gutter": "clamp(12px, 2.4vw, 32px)" },
  "shadow": {
    "sm": [{ "y": 1, "blur": 2, "alpha": 0.08 }],
    "md": [{ "y": 4, "blur": 14, "alpha": 0.12 }],
    "lg": [{ "y": 16, "blur": 40, "alpha": 0.22 }]
  },
  "z": { "dropdown": 20, "sticky": 30, "drawer": 40, "dialog": 50, "toast": 60 },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.7,.2,1)" }
}
