{
  "name": "@northline/tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "The brand (brand.json + palettes/*.json) and the fixed rhythm (scale.json): dist/tokens.css for the web, generated/theme.json for TypeScript and the native apps, the contrast gate.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css",
    "./palettes.css": "./dist/palettes.css",
    "./theme.json": "./generated/theme.json",
    "./brand.json": "./brand.json",
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --check"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0"
  }
}
