# web/apps/console/.env.example — `cp .env.example .env` (git-ignored). Vite reads this file for `pnpm dev:console`;
# shell variables win over it. docs/runbooks/local.md § 5c, docs/CONSOLE_PLAN.md § Running it.

# Where /api, /bff, /oauth2 and /login go (the console-bff: `:bff:bootRun` with profiles local,console, port 8083).
NL_BFF=http://localhost:8083
# Dev auth: a seeded staff member's identity.users id — /api goes straight to the api (profile `local` only) with
# X-Dev-User (roles from identity.platform_roles, acr=mfa), /bff/session is answered by the dev server.
# Priya Natarajan (every console role, db/seed-dev/V191): 01J9ZD3V00000000000000PNA1.
NL_DEV_USER=
# Where /api goes under dev auth.
NL_API=http://localhost:8080
# NL_DEV_USER_NAME=Priya Natarajan
# northline-auth's public origin for the sign-in page (build-time default; the container reads NL_AUTH_ORIGIN).
VITE_NL_AUTH_ORIGIN=http://localhost:9000
