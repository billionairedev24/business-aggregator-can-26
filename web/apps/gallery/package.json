{
  "name": "@northline/gallery",
  "private": true,
  "type": "module",
  "description": "The @northline/ui component gallery (S-168): every component in en and fr-CA, a dev-only app (never deployed) and the Playwright screenshot baselines of `pnpm test:visual`.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:visual": "playwright test -c visual/playwright.config.ts",
    "test:visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots",
    "predev": "pnpm --filter @northline/tokens build",
    "prebuild": "pnpm --filter @northline/tokens build"
  },
  "dependencies": {
    "@northline/tokens": "workspace:*",
    "@northline/ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
