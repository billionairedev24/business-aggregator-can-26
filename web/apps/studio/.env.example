# web/apps/studio/.env.example — `cp .env.example .env` (git-ignored). Vite reads this file for `pnpm dev`;
# shell variables win over it. Nothing here is used by a production build except VITE_* values baked in at build time.

# --- Dev server proxy (vite.config.ts; dev only) ---------------------------------------------------------------
# Where /api, /bff, /oauth2 and /login go when you sign in for real (studio-bff).
NL_BFF=http://localhost:8082
# Dev auth: set a seeded identity.users id and the Studio skips auth + bff — /api goes straight to the api (profile
# `local` only) with X-Dev-User. Ravi Sandhu (owner of all three seeded businesses): 01J9ZD3V00000000000000RAV1.
# Leave empty to sign in through northline-auth.
NL_DEV_USER=
# Where /api goes under dev auth.
NL_API=http://localhost:8080
# Name / email the fake /bff/session reports under dev auth.
# NL_DEV_USER_NAME=Ravi Sandhu
# NL_DEV_USER_EMAIL=ravi@prairiewrench.ca

# --- Baked into the bundle (VITE_*) ---------------------------------------------------------------------------
# northline-auth's public origin (the sign-in / register JSON API). Must equal AUTH_ISSUER on the server.
VITE_NL_AUTH_ORIGIN=http://localhost:9000
# 1 = payout step-up accepts the proof "dev" (api `local` profile only; pairs with NL_DEV_USER).
VITE_NL_DEV_STEP_UP=
