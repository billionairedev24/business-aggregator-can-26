# web/apps/consumer/.env.example — `cp .env.example .env` (git-ignored). Vite reads this file for `pnpm dev:consumer`;
# shell variables win over it. docs/runbooks/local.md § 5b.

# --- Dev server proxy (vite.config.ts; dev only) ---------------------------------------------------------------
# Where /api, /bff, /oauth2 and /login go (the consumer-bff: `:bff:bootRun` with profiles local,consumer).
NL_BFF=http://localhost:8081
# Dev auth: a seeded identity.users id — /api goes straight to the api (profile `local` only) with X-Dev-User as a
# single-factor consumer, /bff/session is answered by the dev server. Amara Osei: 01J9ZD3V0000000000000C0001.
NL_DEV_USER=
# Or browse as a guest without the bff (1).
NL_DEV_GUEST=
# Where /api goes under dev auth.
NL_API=http://localhost:8080
# NL_DEV_USER_NAME=Amara Osei
# NL_DEV_USER_EMAIL=amara.osei@example.com

# --- Server-side rendering (also read by the container) -------------------------------------------------------
# Where the server fetches public data: the consumer-bff (default), or the api under dev auth.
NL_BFF_URL=http://localhost:8081
# northline-auth's public origin (sign-out; S-62's sign-in pages). Must equal AUTH_ISSUER on the server.
NL_AUTH_ORIGIN=http://localhost:9000
