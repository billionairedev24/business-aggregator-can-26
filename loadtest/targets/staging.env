# S-119 target: staging, from a k6 pod inside the cluster (the api is not public: docs/runbooks/load-testing.md § Staging).
# The manifest and the tokens describe staging's load-test accounts and businesses; neither is in git.
API_URL=${API_URL:-http://northline-api.northline-staging.svc:8080}
AUTH_MODE=${AUTH_MODE:-bearer}
MANIFEST=${MANIFEST:-.data/staging-manifest.json}
TOKENS_FILE=${TOKENS_FILE:-.data/staging-tokens.json}
