# S-119 target: the dedicated local stack of loadtest/stack.sh (dev auth, the seeded manifest). Values already in the
# environment win (API_URL=http://localhost:8080 make load-smoke for your own `make up` api with SEARCH_PROVIDER etc.).
API_URL=${API_URL:-http://localhost:18080}
AUTH_MODE=${AUTH_MODE:-dev}
MANIFEST=${MANIFEST:-.data/manifest.json}
