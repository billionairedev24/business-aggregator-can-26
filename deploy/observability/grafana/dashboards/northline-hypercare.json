            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(northline_market_activity_total{market=\"$market\",kind=\"order\"}[24h])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
