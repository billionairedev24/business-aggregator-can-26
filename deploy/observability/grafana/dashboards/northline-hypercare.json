{
  "uid": "northline-hypercare",
  "title": "Northline · hypercare (market launch)",
  "description": "The first 14 days of a market: its orders, bookings, payouts and support tickets (market label), platform checkout errors, sign-in failures and paging alerts, and the pilot group's UAT feedback (S-121). Daily stand-up: docs/runbooks/go-live.md § Hypercare.",
  "tags": [
    "northline",
    "hypercare",
    "flow"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      },
      {
        "name": "market",
        "label": "Market",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(northline_market_activity_total, market)",
        "query": {
          "query": "label_values(northline_market_activity_total, market)",
          "refId": "market"
        },
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
