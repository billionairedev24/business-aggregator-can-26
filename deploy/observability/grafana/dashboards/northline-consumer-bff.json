{
  "uid": "northline-consumer-bff",
  "title": "Northline · consumer-bff",
  "description": "northline-consumer-bff: requests (rate, errors, duration), outgoing calls, JVM, database pool. Traces: Explore → Tempo / X-Ray / Cloud Trace with service.name=northline-consumer-bff.",
  "tags": [
    "northline",
    "service",
    "consumer-bff"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
