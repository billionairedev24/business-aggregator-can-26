variable "environment" {
  description = "dev, staging, prod or dryrun (the demo environment, envs/gcp/dryrun)."
  type        = string
}

variable "zone" {
  description = "Zone of the zonal cluster (dev, dryrun) and of the in-cluster data services' volumes; null = <region>-a."
  type        = string
  default     = null
}

variable "region" {
  description = "Canadian Google Cloud region."
  type        = string
}

variable "owner" {
  description = "Owner tag (team or person accountable for the environment)."
  type        = string
}

variable "cidr" {
  description = "VPC address space."
  type        = string
}

variable "zone_count" {
  description = "Availability zones (2 or 3)."
  type        = number
}

variable "high_availability_nat" {
  description = "One NAT gateway per zone."
  type        = bool
}

variable "kubernetes_version" {
  description = "GKE minor version; null = the release channel default."
  type        = string
  default     = null
}

variable "node_pools" {
  description = "GKE node pools (see modules/kubernetes)."
  type = map(object({
    machine_type = string
    min_count    = number
    max_count    = number
    disk_size_gb = optional(number, 50)
    spot         = optional(bool, false)
    labels       = optional(map(string), {})
  }))
}

variable "api_allowed_cidrs" {
  description = "CIDRs allowed to reach the Kubernetes API."
  type        = list(string)
  default     = []
}

variable "admin_principals" {
  description = "IAM members (user:… / group:…) granted roles/container.admin."
  type        = list(string)
  default     = []
}

variable "dns_zone_name" {
  description = "DNS zone of the environment."
  type        = string
}

variable "bucket_name_suffix" {
  description = "Suffix for globally unique bucket names."
  type        = string
  default     = ""
}

variable "deletion_protection" {
  description = "Protect stateful resources from destroy (prod)."
  type        = bool
}

variable "project_id" {
  description = "Google Cloud project of this environment (one project per environment is recommended)."
  type        = string
}

variable "data_stores" {
  description = "Sizes of the managed data stores (S-3); instance types/tiers are the cloud's own names (see modules/<store>/variables.tf). null = no managed data stores: data_services instead (dryrun)."
  default     = null
  type = object({
    postgres = object({
      instance_size         = string
      storage_gb            = number
      high_availability     = bool
      backup_retention_days = number
    })
    cache = object({
      node_size = string
      replicas  = number
    })
    kafka = object({
      tier       = string
      capacity   = number
      storage_gb = number
    })
    search = object({
      size       = string
      zone_count = number
    })
  })
}

# dryrun (docs/runbooks/dryrun-gcp.md): instead of the managed data stores, each service runs either in the cluster
# (deploy/helm/northline-data: CloudNativePG Postgres + PostGIS, Valkey, Meilisearch, single-broker KRaft Kafka) or at
# an external provider (e.g. Layerbase). Only endpoints and user names here (config_env); credentials are Secret
# Manager secrets: generated by this stack for in-cluster services, created empty for external ones.
variable "data_services" {
  description = "Per service: mode = in-cluster | external. External: postgres.db_url (JDBC with sslmode) + db_user; cache host/port/ssl/username; search.url (Meilisearch); kafka bootstrap/security_protocol/sasl_mechanism. null = the managed data stores of data_stores."
  default     = null
  type = object({
    postgres = object({
      mode    = optional(string, "in-cluster")
      db_url  = optional(string, "")
      db_user = optional(string, "northline_app")
    })
    cache = object({
      mode     = optional(string, "in-cluster")
      host     = optional(string, "")
      port     = optional(number, 6379)
      ssl      = optional(bool, false)
      username = optional(string, "")
    })
    search = object({
      mode = optional(string, "in-cluster")
      url  = optional(string, "")
    })
    kafka = object({
      mode              = optional(string, "in-cluster")
      bootstrap         = optional(string, "")
      security_protocol = optional(string, "PLAINTEXT")
      sasl_mechanism    = optional(string, "")
    })
  })

  validation {
    condition     = (var.data_services == null) != (var.data_stores == null)
    error_message = "Set exactly one of data_stores (managed, S-3) and data_services (dryrun: in-cluster or external)."
  }

  validation {
    condition     = var.data_services == null || alltrue([for s in ["postgres", "cache", "search", "kafka"] : contains(["in-cluster", "external"], try(var.data_services[s].mode, ""))])
    error_message = "data_services.<service>.mode must be in-cluster or external."
  }

  validation {
    condition = var.data_services == null || (
      (try(var.data_services.postgres.mode, "") != "external" || startswith(try(var.data_services.postgres.db_url, ""), "jdbc:postgresql://")) &&
      (try(var.data_services.cache.mode, "") != "external" || try(var.data_services.cache.host, "") != "") &&
      (try(var.data_services.search.mode, "") != "external" || startswith(try(var.data_services.search.url, ""), "https://")) &&
      (try(var.data_services.kafka.mode, "") != "external" || try(var.data_services.kafka.bootstrap, "") != "")
    )
    error_message = "An external service needs its endpoint: postgres.db_url (jdbc:postgresql://…?sslmode=require), cache.host, search.url (https://…), kafka.bootstrap."
  }
}

variable "signing_key_ids" {
  description = "Token signing key rotation (docs/runbooks/key-rotation.md § Rotating — cloud providers). active = KMS_KEY_ID (null = the signing key Terraform created: AWS key ARN, Google Cloud key version name, Azure versioned key URL); published = KMS_PUBLISHED_KEY_IDS (keys published without signing: the next key before a switch, the previous one after it)."
  type = object({
    active    = optional(string)
    published = optional(list(string), [])
  })
  default = {}
}

variable "backup" {
  description = "S-114 backups and disaster recovery (docs/runbooks/backups-dr.md). cross_region = keep a copy of the database and of every bucket in the other Canadian region of this cloud (prod); copy_retention_days = how long that region keeps the database's replicated backups (AWS); replica_cool_after_days / replica_noncurrent_days = the replica buckets' lifecycle."
  type = object({
    cross_region            = optional(bool, false)
    copy_retention_days     = optional(number, 14)
    replica_cool_after_days = optional(number, 30)
    replica_noncurrent_days = optional(number, 90)
  })
  default = {}
}
