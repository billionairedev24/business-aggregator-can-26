# Copy to terraform.tfvars (git-ignored) and fill in.
project_id = "northline-staging"
region = "northamerica-northeast1"
owner  = "platform"
admin_principals  = []  # e.g. ["group:northline-ops@northline.ca"]
api_allowed_cidrs = []  # required (staging and prod): office/VPN/CI egress CIDRs, e.g. ["203.0.113.0/24"]
# Token signing key rotation only (docs/runbooks/key-rotation.md); leave unset otherwise.
# signing_key_ids = { active = "<old key id>", published = ["<new key id>"] }
